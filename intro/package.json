    "@typescript-eslint/parser": "^8.32.1",
    "dotenv": "^16.0.3",
    "eslint": "^9.27.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.27.5",
